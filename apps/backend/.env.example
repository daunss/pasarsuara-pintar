# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# AI Services
GEMINI_API_KEY=your_gemini_api_key_here
KOLOSAL_API_KEY=your_kolosal_api_key_here
KOLOSAL_BASE_URL=https://api.kolosal.ai/v1

# Server
PORT=8080
BACKEND_PORT=8080

# WA Gateway (for outbound WhatsApp messages)
WA_GATEWAY_URL=http://localhost:8081
WA_GATEWAY_API_KEY=

# Midtrans (QRIS)
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false

# Optional: Multiple Gemini keys for rotation (comma-separated)
# GEMINI_API_KEY=key1,key2,key3
